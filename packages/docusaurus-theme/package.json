{
  "name": "@aeei/docusaurus-theme",
  "version": "0.1.4",
  "description": "A shadcn Base Nova theme for Docusaurus docs.",
  "license": "MIT",
  "keywords": [
    "base-ui",
    "documentation",
    "docusaurus",
    "mermaid",
    "shadcn",
    "theme"
  ],
  "publishConfig": {
    "access": "public"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/aeei/docusaurus-theme.git",
    "directory": "packages/docusaurus-theme"
  },
  "bugs": {
    "url": "https://github.com/aeei/docusaurus-theme/issues"
  },
  "types": "src/theme-classic.d.ts",
  "main": "lib/index.js",
  "files": [
    "lib",
    "lib-theme",
    "src/theme",
    "src/plugin-content-docs.d.ts",
    "src/theme-classic.d.ts",
    "README.md",
    "VENDORED_SOURCES.md",
    "LICENSE",
    "LICENSES",
    "THIRD_PARTY_NOTICES.md"
  ],
  "scripts": {
    "build": "node scripts/clean-build.mjs && tsc --build --force && tsc --project tsconfig.theme.json && node ../../scripts/copyUntypedFiles.mjs && node scripts/copy-theme-assets.mjs && tailwindcss -i src/theme/shadcn.css -o lib/theme/shadcn.scss --minify && node scripts/normalize-tailwind-css.mjs && prettier --config ../../.prettierrc.json --write \"lib/theme/**/*.js\" \"lib-theme/theme/**/*.js\""
  },
  "dependencies": {
    "@base-ui/react": "^1.6.0",
    "class-variance-authority": "^0.7.1",
    "node-html-parser": "^9.0.0",
    "clsx": "^2.1.1",
    "cmdk": "^1.1.1",
    "copy-text-to-clipboard": "^3.2.0",
    "lucide-react": "^0.468.0",
    "parse-numeric-range": "^1.3.0",
    "postcss": "^8.5.13",
    "postcss-preset-env": "^10.6.1",
    "prism-react-renderer": "^2.4.1",
    "sass": "^1.89.2",
    "sass-loader": "^16.0.5",
    "tailwind-merge": "^3.4.0"
  },
  "devDependencies": {
    "@docusaurus/core": "^3.10.0",
    "@docusaurus/theme-classic": "^3.10.0",
    "@docusaurus/theme-common": "^3.10.0",
    "@docusaurus/types": "^3.10.0",
    "@tailwindcss/cli": "^4.3.2",
    "tailwindcss": "^4.3.2"
  },
  "peerDependencies": {
    "@docusaurus/core": "^3.10.0",
    "@docusaurus/plugin-content-docs": "^3.10.0",
    "@docusaurus/theme-common": "^3.10.0",
    "react": "^18.0.0 || ^19.0.0",
    "react-dom": "^18.0.0 || ^19.0.0"
  },
  "engines": {
    "node": ">=20"
  }
}
