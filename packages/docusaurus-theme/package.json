{
  "name": "@aeei/docusaurus-theme",
  "version": "0.1.0",
  "description": "A shadcn Base Nova theme for Docusaurus docs.",
  "license": "MIT",
  "keywords": [
    "base-ui",
    "documentation",
    "docusaurus",
    "mermaid",
    "shadcn",
    "theme"
  ],
  "publishConfig": {
    "access": "public"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/aeei/docusaurus-theme.git",
    "directory": "packages/docusaurus-theme"
  },
  "bugs": {
    "url": "https://github.com/aeei/docusaurus-theme/issues"
  },
  "types": "src/theme-classic.d.ts",
  "main": "lib/index.js",
  "files": [
    "lib",
    "src/theme",
    "src/plugin-content-docs.d.ts",
    "src/theme-classic.d.ts",
    "README.md",
    "VENDORED_SOURCES.md",
    "LICENSE",
    "LICENSES",
    "THIRD_PARTY_NOTICES.md"
  ],
  "scripts": {
    "build": "tsc --build && node ../../scripts/copyUntypedFiles.mjs && tailwindcss -i src/theme/shadcn.css -o lib/theme/shadcn.scss --minify && prettier --config ../../.prettierrc.json --write \"lib/theme/**/*.js\""
  },
  "dependencies": {
    "@base-ui/react": "^1.6.0",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "lucide-react": "^0.468.0",
    "parse-numeric-range": "^1.3.0",
    "prism-react-renderer": "^2.4.1",
    "sass": "^1.89.2",
    "sass-loader": "^16.0.5",
    "tailwind-merge": "^3.4.0"
  },
  "devDependencies": {
    "@docusaurus/core": "^3.10.0",
    "@docusaurus/theme-classic": "^3.10.0",
    "@docusaurus/theme-common": "^3.10.0",
    "@docusaurus/types": "^3.10.0",
    "@tailwindcss/cli": "^4.3.2",
    "tailwindcss": "^4.3.2"
  },
  "peerDependencies": {
    "@docusaurus/core": "^3.10.0",
    "@docusaurus/theme-classic": "^3.10.0",
    "@docusaurus/theme-common": "^3.10.0",
    "react": "^18.0.0 || ^19.0.0",
    "react-dom": "^18.0.0 || ^19.0.0"
  },
  "engines": {
    "node": ">=20"
  }
}
