{
  "extends": "../../tsconfig.base.json",
  "compilerOptions": {
    "lib": ["ESNext", "DOM"],
    "rootDir": "src",
    "module": "ESNext",
    "moduleResolution": "Node",
    "target": "ES2020",
    "noEmit": false,
    "outDir": "lib-theme",
    "jsx": "react",
    "paths": {
      "@theme/*": ["./src/theme/*"]
    }
  },
  "include": ["src/theme", "src/*.d.ts"],
  "exclude": ["src/**/*.test.ts", "src/**/*.test.tsx"]
}
